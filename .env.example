# Bun loads .env; never commit credentials.
DATABASE_URL=postgresql://localhost:5432/jio_payments
PUBLIC_ORIGIN=http://127.0.0.1:4020
PORT=4020
SELLER_ADDRESS=
JIO_API_URL=https://your-jio-api.example
JIO_API_KEY=
# If your deployment uses a private CA, obtain it from your Jio operator.
# Set this before starting Bun; never disable certificate verification.
# NODE_EXTRA_CA_CERTS=/absolute/path/to/jio-ca.pem
# Buyer only. Never install these in the rented VM.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ADDRESS=
SSH_PUBLIC_KEY=
BUDGET_ATOMIC=10000
# Separate treasury command uses seller credentials; public gateway needs none.
